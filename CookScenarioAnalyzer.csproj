<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PluginInternalName>CookScenarioAnalyzer</PluginInternalName>
    <PluginAuthor>不记得了</PluginAuthor>
    <PluginDisplayName>解析种田杯回合信息</PluginDisplayName>
    <PluginDescription>解析种田杯回合信息</PluginDescription>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/CookScenarioAnalyzer</PluginRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="i18n\Game.Designer.cs">
      <DependentUpon>Game.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\Game.resx">
      <LastGenOutput>Game.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="2026.9.1" />
  </ItemGroup>

</Project>
